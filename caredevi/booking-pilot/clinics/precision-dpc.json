      "faq": [
        {
          "q": "What is Direct Primary Care?",
          "a": "DPC is a membership-based healthcare model where you pay your doctor directly — no insurance billing for routine care.",
          "bullets": [
            "Monthly membership covers all primary care visits",
            "Like a gym membership, but for your healthcare",
            "Longer visits, better access, transparent pricing"
          ],
          "keyPoint": "No insurance middleman"
        },
        {
          "q": "How is DPC different from concierge medicine?",
          "a": "Concierge practices charge $2,000–$10,000/year and still bill insurance. DPC is more affordable and fully transparent.",
          "bullets": [
            "DPC: $50–$130/mo — Concierge: $2K–$10K/year",
            "DPC does NOT bill insurance for covered services",
            "Same great access at a fraction of the cost"
          ],
          "keyPoint": "Up to 90% less than concierge"
        },
        {
          "q": "Do I still need health insurance?",
          "a": "Yes — keep insurance for major events. DPC handles your day-to-day primary care.",
          "bullets": [
            "Insurance covers: hospital stays, specialists, emergencies",
            "DPC covers: office visits, labs, routine procedures",
            "Many members pair DPC with a high-deductible plan (HDHP)"
          ],
          "keyPoint": "DPC + HDHP = maximum savings"
        },
        {
          "q": "What services are included?",
          "a": "Your membership covers a wide range of primary and preventive care:",
          "bullets": [
            "Unlimited office visits (primary & urgent care)",
            "Same-day / next-day appointments guaranteed",
            "24/7 direct access — call, text, or email Dr. Farley",
            "Annual wellness exams & basic in-office procedures",
            "Wholesale labs & medications (90%+ savings)",
            "Chronic disease management"
          ],
          "keyPoint": "Unlimited visits included"
        },
        {
          "q": "How do I schedule appointments?",
          "a": "Multiple convenient options:",
          "bullets": [
            "Call, text, or email Dr. Farley directly",
            "Schedule through the CareDevi app",
            "Walk-ins welcome during office hours",
            "Same-day or next-day availability guaranteed"
          ],
          "keyPoint": "Same-day guarantee"
        },
        {
          "q": "Are family plans available?",
          "a": "Yes! Great rates for the whole family:",
          "bullets": [
            "Ages 0-22: $50/mo — lowest rate",
            "Ages 23-39: $80/mo",
            "Ages 40-64: $100/mo",
            "Ages 65+: $130/mo",
            "Family maximum of $300/mo",
            "50% off 5th+ member ($25/mo each additional child)"
          ],
          "keyPoint": "Family max $300/mo"
        },
        {
          "q": "What about labs & prescriptions?",
          "a": "Members get wholesale pricing — often 90-95% less than hospital prices.",
          "bullets": [
            "Basic metabolic panel: $3-5 (vs $100+ at hospital)",
            "Negotiated wholesale medication prices",
            "Generic alternatives at a fraction of retail cost"
          ],
          "keyPoint": "Up to 95% savings on labs"
        },
        {
          "q": "Is there a contract?",
          "a": "There is a minimum 6-month commitment to give DPC a fair chance. After that, you can cancel anytime.",
          "bullets": [
            "Minimum 6-month membership commitment",
