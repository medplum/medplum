{
  "name": "medplum-preauth-demo",
  "version": "5.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc && vite build",
    "build:bots": "npm run clean && tsc && node --no-warnings esbuild-script.mjs && tsx src/scripts/deploy-bots.ts",
    "clean": "rimraf dist",
    "dev": "vite",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "preview": "vite preview"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@mantine/notifications": "8.3.18",
    "@medplum/bot-layer": "5.2.0",
    "@medplum/core": "5.2.0",
    "@medplum/eslint-config": "5.2.0",
    "@medplum/fhirtypes": "5.2.0",
    "@medplum/react": "5.2.0",
    "@tabler/icons-react": "3.48.0",
    "@types/node": "22.20.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "fast-glob": "3.3.3",
    "postcss": "8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.0",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  }
}
