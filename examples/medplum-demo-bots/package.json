{
  "name": "medplum-demo-bots",
  "version": "5.2.2",
  "description": "Medplum Demo Bots",
  "license": "Apache-2.0",
  "author": "Medplum <hello@medplum.com>",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc && node --no-warnings esbuild-script.mjs",
    "clean": "rimraf dist",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prettier": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@medplum/bot-layer": "5.2.2",
    "@medplum/cli": "5.2.2",
    "@medplum/core": "5.2.2",
    "@medplum/eslint-config": "5.2.2",
    "@medplum/fhirtypes": "5.2.2",
    "@medplum/mock": "5.2.2",
    "@types/node": "22.20.5",
    "@types/ssh2-sftp-client": "9.0.6",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "esbuild": "0.28.2",
    "fast-glob": "3.3.3",
    "fast-xml-parser": "5.11.2",
    "form-data": "4.0.6",
    "pdfmake": "0.2.21",
    "rimraf": "6.1.3",
    "ssh2-sftp-client": "12.1.1",
    "stripe": "23.0.0",
    "twilio": "^6.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  }
}
