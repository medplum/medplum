# Medplum server base URL.
# Local Medplum server: http://localhost:8103/
# Hosted Medplum:      https://api.medplum.com/
MEDPLUM_BASE_URL=https://api.medplum.com/

# Credentials for `npm run convert -- --seed`: a ClientApplication in the target project.
# Its ProjectMembership must be a project admin (Patient/$set-accounts is admin-only).
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
