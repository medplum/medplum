{
  "name": "medplum-google-calendar-sync",
  "version": "5.2.13",
  "private": true,
  "description": "Medplum Google Calendar sync with outbound mirrors and inbound busy-time Slots",
  "repository": {
    "type": "git",
    "url": "https://github.com/medplum/medplum.git",
    "directory": "examples/medplum-google-calendar-sync"
  },
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run lint && npm run profiles:check && tsc && node esbuild.mjs",
    "clean": "rimraf dist",
    "connect-local": "tsx src/scripts/connect-local.ts",
    "deploy": "npm run build && tsx src/scripts/deploy-bots.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix && prettier --write src",
    "live-api-probe": "tsx src/scripts/live-google-test.ts",
    "migrate-mirrors": "tsx src/scripts/migrate-mirrors.ts",
    "profiles": "tsx src/scripts/generate-profiles.ts",
    "profiles:check": "tsx src/scripts/generate-profiles.ts --check",
    "setup:project": "tsx src/scripts/install-project.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx src/scripts/e2e.ts",
    "test:e2e:cleanup": "tsx src/scripts/e2e.ts --cleanup"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@medplum/core": "5.2.13",
    "@medplum/definitions": "5.2.13",
    "@medplum/eslint-config": "5.2.13",
    "@medplum/fhirtypes": "5.2.13",
    "@medplum/mock": "5.2.13",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "glob": "13.0.6",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.22.0 <23.0.0 || >=24.2.0 <25.0.0"
  }
}
