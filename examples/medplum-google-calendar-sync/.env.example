# Copy to .env, fill in your values, and load explicitly; scripts do not load dotenv.
# Never commit .env or files containing tokens, deployment IDs or live-test manifests.
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_PROFILE=gcal-sandbox
PROJECT_ID=YOUR_PROJECT_ID

# Google OAuth client used by setup:project.
GOOGLE_CALENDAR_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CALENDAR_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALENDAR_DETAIL_LEVEL=busy-only
# Optional authenticated application deep link; {id} becomes the Appointment ID.
# GOOGLE_CALENDAR_APPOINTMENT_URL=https://example.com/appointments/{id}

# Optional service-client authentication for deploy without --cli and migrate-mirrors.
# CLIENT_ID=YOUR_MEDPLUM_CLIENT_ID
# CLIENT_SECRET=YOUR_MEDPLUM_CLIENT_SECRET
# BASE_URL=https://api.medplum.com/
# CONNECTION_ID=YOUR_CONNECTION_ID

# Set a new absolute, ignored manifest path for each new live test run.
# E2E_MANIFEST=/absolute/path/to/test-results/calendar-run.json
