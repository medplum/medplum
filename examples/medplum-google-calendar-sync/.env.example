# Copy to .env and fill in your values. The deploy and connect-local scripts read this file;
# a variable already set in the shell takes precedence. Never commit .env.
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_PROFILE=gcal-sandbox
PROJECT_ID=YOUR_PROJECT_ID

# Only for connect-local. The installed integration reads the Google client from project secrets.
# GOOGLE_CALENDAR_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Optional service-client authentication for deploy without --cli.
# CLIENT_ID=YOUR_MEDPLUM_CLIENT_ID
# CLIENT_SECRET=YOUR_MEDPLUM_CLIENT_SECRET
