    "open-color": "1.9.1",
    "postcss": "8.5.30",
    "postcss-cli": "12.0.0",
    "postcss-pxtorem": "6.1.0",
    "postcss-scss": "4.0.9",
    "rimraf": "6.1.3",
    "sass-embedded": "1.105.1",
    "swup": "4.10.0"
