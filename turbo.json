{
  "$schema": "https://turborepo.org/schema.json",
  "globalEnv": ["NODE_VERSION", "MEDPLUM_GIT_SHORTHASH"],
  "tasks": {
    "clean": {
      "outputs": ["build/**", "dist/**", "coverage/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "MEDPLUM_BASE_URL",
        "MEDPLUM_CLIENT_ID",
        "MEDPLUM_INTROSPECTION_URL",
        "MEDPLUM_REGISTER_ENABLED",
        "GOOGLE_CLIENT_ID",
        "RECAPTCHA_SITE_KEY"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**", ".vitest-reports/**"],
      "inputs": [
        "src/**/*.tsx",
        "src/**/*.ts",
        "vite.config.ts",
        "vite.config.js",
        "vitest.config.ts",
        "vitest.config.js",
        "$TURBO_ROOT$/vitest.config.ts"
      ]
    },
    "lint": {
      "dependsOn": ["build"]
    },
    "lint:fix": {
      "dependsOn": ["build"]
    }
  }
}
