{
  "name": "root",
  "version": "5.2.17",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=!@medplum/docs --filter=!@medplum/storybook --filter=!./examples/*",
    "build:all": "turbo run build",
    "build:docs": "turbo run build --filter=@medplum/docs",
    "build:fast": "turbo run build --filter=@medplum/app --filter=@medplum/server",
    "clean": "turbo run clean",
    "lint": "turbo run lint --filter=!@medplum/docs",
    "lint:fix": "turbo run lint:fix --filter=!@medplum/docs",
    "prettier": "prettier --write \"**/*.{ts,tsx,cts,mts,js,jsx,cjs,mjs,json}\"",
    "sort-package-json": "sort-package-json package.json \"packages/*/package.json\" \"examples/*/package.json\"",
    "test": "turbo run test --filter=!@medplum/docs"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ],
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "uuid": "14.0.2",
    "whatwg-url": "14.0.0",
    "import-in-the-middle": "3.4.0",
    "tinypool": "2.2.0"
  },
  "devDependencies": {
    "@microsoft/api-documenter": "7.30.20",
    "@microsoft/api-extractor": "7.60.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "formidable": "3.5.4",
    "jsdom": "29.1.1",
    "npm-check-updates": "22.2.9",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "rimraf": "6.1.4",
    "shx": "0.4.0",
    "sort-package-json": "4.1.0",
    "source-map-explorer": "2.5.3",
    "storybook": "10.6.6",
    "tslib": "2.9.1",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "4.1.12",
    "vitest-websocket-mock": "0.5.0"
  },
  "packageManager": "npm@11.21.2+sha512.ec73c0a64f807e53146af4ac78bd4f9ba0a762a3081e4e77c7e2a6ba1aa64c3a8f9233cc8312294cf713aac13dd4428dc3880504957d7e75e249d1a6d435eaf4",
  "engines": {
    "node": ">=22.22.0 <23.0.0 || >=24.2.0 <25.0.0"
  }
}
